# Configuración de Locust para pruebas de rendimiento
# Copia este archivo a locust.env y ajusta los valores según necesites

# Host del microservicio
LOCUST_HOST=http://136.112.218.8:5000

# Configuración de usuarios (valores por defecto, se pueden sobrescribir en CLI)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2
LOCUST_RUN_TIME=5m

# Configuración de la interfaz web de Locust
LOCUST_WEB_HOST=0.0.0.0
LOCUST_WEB_PORT=8089

# Modo headless (sin interfaz web)
LOCUST_HEADLESS=false

# Configuración de logs
LOCUST_LOG_LEVEL=INFO

# Configuración de exportación de resultados
LOCUST_EXPORT_HTML=true
LOCUST_EXPORT_CSV=true
LOCUST_RESULTS_DIR=locust_results

# Timeout de requests (segundos)
LOCUST_REQUEST_TIMEOUT=30

# Verificar certificados SSL
LOCUST_VERIFY_SSL=true

# Credenciales de prueba (para usuarios que no se registran)
# Asegúrate de que este usuario exista en la base de datos
TEST_USERNAME=testuser
TEST_PASSWORD=testpass123

# Configuración de espera entre requests (segundos)
LOCUST_MIN_WAIT=1
LOCUST_MAX_WAIT=3



