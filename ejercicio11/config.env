# Configuración del microservicio ejercicio 11
# IMPORTANTE: Cambiar estas claves en producción
SECRET_KEY=mi_clave_secreta_super_segura_123
JWT_SECRET_KEY=jwt_clave_secreta_456
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MIN=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Base de datos MySQL/MariaDB
# Para GCP: usar 127.0.0.1 si MySQL está en la misma instancia
# Para Cloud SQL: usar la IP interna o el nombre de conexión
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=libros_user
MYSQL_PASSWORD=666
MYSQL_DB=JWT03
MYSQL_CURSORCLASS=DictCursor

# Flask
# IMPORTANTE: 0.0.0.0 permite conexiones externas (necesario para GCP)
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
# CORS: * permite todos los orígenes, ajustar en producción
CORS_ORIGINS=*

